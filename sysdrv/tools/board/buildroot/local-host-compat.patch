--- a/package/e2fsprogs/e2fsprogs.mk
+++ b/package/e2fsprogs/e2fsprogs.mk
@@ -99,5 +99,13 @@
 endef
 HOST_E2FSPROGS_POST_INSTALL_HOOKS += HOST_E2FSPROGS_REMOVE_COMPILE_ET
 
+# Older configure only recognizes GNU mkdir and selects a broken fallback
+# for uutils mkdir. Both implementations support mkdir -p.
+E2FSPROGS_CONF_ENV += MKDIR_P="mkdir -p"
+HOST_E2FSPROGS_CONF_ENV += MKDIR_P="mkdir -p"
+
+# The bundled tdb code defines bool, which is a keyword in C23.
+HOST_E2FSPROGS_CONF_ENV += CFLAGS="$(HOST_CFLAGS) -std=gnu17"
+
 $(eval $(autotools-package))
 $(eval $(host-autotools-package))
